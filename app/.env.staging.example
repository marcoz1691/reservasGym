# Supabase STAGING — copiar a .env.staging y completar credenciales
# Proyecto recomendado en dashboard: zona-cero-staging
# Uso: npm run dev:staging

VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Pago online Ecuador — pago único con Pagomedios (default, secret PAGOMEDIOS_TOKEN en Supabase)
# o Datafast Dataweb (VITE_PAYMENT_PROVIDER=datafast, secrets DATAFAST_*)
# VITE_ONLINE_PAYMENTS=1
# VITE_PAYMENT_PROVIDER=pagomedios

# Opcional: túnel para probar en celular (vite.config.ts)
# VITE_TUNNEL=1
