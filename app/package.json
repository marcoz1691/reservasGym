{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "provision:staging": "node scripts/provision-staging.mjs",
    "pagomedios:mock": "node scripts/pagomedios-mock.mjs",
    "pagomedios:e2e": "node scripts/pagomedios-e2e.mjs",
    "pagomedios:fn": "DENO_NO_PACKAGE_JSON=1 deno run --allow-net --allow-env --allow-read --env-file=.env.pagomedios.local supabase/functions/pagomedios-payment/index.ts",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:capacitor": "tsc -b && vite build --mode capacitor",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "load:seed": "node --env-file=.env.load.local load/seed-load-users.mjs",
    "load:mint": "node --env-file=.env.load.local load/mint-tokens.mjs",
    "load:a": "bash load/run-k6.sh a",
    "load:b": "bash load/run-k6.sh b",
    "load:check": "node --env-file=.env.load.local load/check-integrity.mjs",
    "load:cleanup": "node --env-file=.env.load.local load/cleanup-load-users.mjs",
    "test:watch": "vitest",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/inappbrowser": "7.22.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sentry/capacitor": "3.2.2",
    "@sentry/react": "10.43.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
